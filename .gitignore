# Ignore python virtual environments
.cloud-transfer/
.venv/

legacy/legacy/novamind/venv/
legacy/novamind/venv/
venv/
kolmo/venv/

# legacy/novamind archived intact (2026-07-29) — see kolmo/ for active work.
# Large persisted state, not useful to track going forward.
legacy/legacy/novamind/save/
legacy/legacy/novamind/checkpoints/

# Ignore cache and compiled files
**/__pycache__/
**/.pytest_cache/
**/*.pyc

# Ignore large data files and logs
legacy/novamind/wikitext_corpus.txt
legacy/novamind/tmp/wikitext_corpus.txt
**/*.log
**/*.pt
**/*.png
**/*.jpg
**/*.jpeg

# Keep experiment files in tmp/ but ignore temporary execution outputs or caches if any
# We want to push the python scripts inside tmp/
# So do NOT ignore legacy/novamind/tmp/ as a whole
legacy/novamind/tmp/checkpoints/
legacy/novamind/tmp/dataset/
legacy/novamind/tmp/data/
legacy/novamind/tmp/arc_data/

# Ignore node_modules (npm dependencies)
**/node_modules/

# Ignore large binary/data directories
legacy/novamind/brainstate/
legacy/novamind/knowledge/

# As VIDAS da mente (estado, fotos, diario) ficam so no PC: centenas de MB por vida e
# nunca devem ser sobrescritas por um clone/reinstalacao. Faca copia antes de atualizar.
disco_d/AGI_Inventor/mente_web/vidas/

